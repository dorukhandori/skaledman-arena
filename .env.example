# Devran sunucu ortamı (deploy/devran.service EnvironmentFile). Kopyala: .env (git'e girmez).
NODE_ENV=production
# D5: kimlik ad + şifre (scrypt). "kick" ileride (Kick OAuth sona bırakıldı; sahip kararı 2026-11-04).
KIMLIK_MODU=sifre
# Oturum çerezi + oda bileti HMAC anahtarı (≥ 32 karakter, rastgele). Üretimde zorunlu. Üret: openssl rand -base64 48
OTURUM_SIRRI=
# WebSocket/HTTP Origin izin listesi (virgüllü). Üretimde zorunlu; boşsa üretimde her bağlantı reddedilir.
IZINLI_KOKENLER=https://devran.ornek-alan.example
# SQLite dizini (devran.sqlite burada). Üretimde zorunlu; systemd ReadWritePaths ile aynı.
VERI_DIZINI=/opt/devran/veri-db
# Cloudflare Tunnel arkasında gerçek istemci IP'si (hız sınırı için) cf-connecting-ip'ten okunsun: 1
GUVENILIR_VEKIL=1
# İLERİDE (Kick OAuth dilimi, D8 sonrası): uçlar doğrulanmadı, Kick geliştirici belgesine göre güncellenecek
# KICK_CLIENT_ID=
# KICK_CLIENT_SECRET=
# KICK_REDIRECT_URI=https://devran.ornek-alan.example/api/geri-donus
