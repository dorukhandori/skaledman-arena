# Devran sunucu ortamı (deploy/devran.service EnvironmentFile). Kopyala: .env (git'e girmez).
NODE_ENV=production
# D4: sahte kimlik yalnız geliştirme / Cloudflare Access arkasındaki test için. D5'te "kick" (Kick OAuth bileti).
KIMLIK_MODU=yerel
# WebSocket/HTTP Origin izin listesi (virgüllü). Üretimde zorunlu; boşsa üretimde her bağlantı reddedilir.
IZINLI_KOKENLER=https://devran.ornek-alan.example
# D5: Kick OAuth (istemci kimliği burada, sır yalnız VPS'te)
# KICK_ISTEMCI_KIMLIGI=
# KICK_ISTEMCI_SIRRI=
# OTURUM_IMZA_ANAHTARI=
